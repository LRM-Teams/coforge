{
  "name": "@coforge/computer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build --compile --env=COFORGE_RELEASE_* ./src/cli.ts --outfile ./dist/coforge-computer",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@coforge/daemon": "workspace:*",
    "@coforge/protocol": "workspace:*",
    "@logtape/file": "2.3.2",
    "@logtape/logtape": "2.3.2",
    "@logtape/redaction": "2.3.2",
    "centrifuge": "5.2.1",
    "commander": "15.0.0",
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "typescript": "7.0.2"
  }
}
