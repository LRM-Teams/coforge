  "dependencies": {
    "@coforge/protocol": "workspace:*",
    "@earendil-works/pi-coding-agent": "0.84.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "typescript": "7.0.2"
  }
}
