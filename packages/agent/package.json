{
  "name": "@coforge/agent",
  "version": "0.1.0",
  "bin": {
    "coforge-agent": "./src/runner.ts"
  },
  "files": [
    "index.ts",
    "src",
    "extensions",
    "skills",
    "README.md"
  ],
  "type": "module",
