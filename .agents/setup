#!/usr/bin/env bash
set -euo pipefail

run_step() {
	local label="$1"
	shift
	local started_at=$SECONDS

	printf '==> %s\n' "$label"
	"$@"
	printf '<== %s (%ss)\n' "$label" "$((SECONDS - started_at))"
}

install_docker() {
	local packages=()
	if ! command -v docker >/dev/null 2>&1; then
		packages+=(docker-ce docker-ce-cli containerd.io)
	fi
	if ! docker buildx version >/dev/null 2>&1; then
		packages+=(docker-buildx-plugin)
	fi
	if ! docker compose version >/dev/null 2>&1; then
		packages+=(docker-compose-plugin)
	fi
	if [[ ${#packages[@]} -eq 0 ]]; then
		return
	fi

	sudo install -m 0755 -d /etc/apt/keyrings
	sudo curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc
	sudo chmod a+r /etc/apt/keyrings/docker.asc

	# shellcheck disable=SC1091
	source /etc/os-release
	printf 'deb [arch=%s signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian %s stable\n' \
		"$(dpkg --print-architecture)" "$VERSION_CODENAME" |
		sudo tee /etc/apt/sources.list.d/docker.list >/dev/null
	sudo apt-get update
	sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y "${packages[@]}"
	sudo usermod -aG docker "$(id -un)"

	docker buildx version >/dev/null
	docker compose version >/dev/null
}

install_linux_credential_store() {
	if [[ "$(uname -s)" != Linux ]]; then
		return
	fi

	local package
	local missing=false
	for package in libsecret-1-0 gnome-keyring; do
		if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -Fqx 'install ok installed'; then
			missing=true
		fi
	done
	if [[ "$missing" == true ]]; then
		sudo apt-get update
		sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y libsecret-1-0 gnome-keyring
	fi
}

mise_bin="$HOME/.local/bin/mise"

if [[ ! -x "$mise_bin" ]]; then
	run_step "Install mise" env MISE_INSTALL_PATH="$mise_bin" sh -c 'curl -fsSL https://mise.run | sh'
fi

profile_marker="# CoForge mise tools"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
	cat >>"$HOME/.bash_profile" <<'EOF'

# CoForge mise tools
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"
EOF
fi

export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"

run_step "Install Docker" install_docker
run_step "Install Linux credential store" install_linux_credential_store
run_step "Install pinned toolchain" "$mise_bin" install --locked
run_step "Install Bun dependencies" "$mise_bin" run install

printf 'Orb setup complete.\n'
