# Merge `default_sni <public-ipv4>` into the live Caddyfile's single global
# options block, then import this site fragment and pass the public IPv4 address
# plus the host-side address reachable from the existing Caddy container:
# import /data/coforge.caddy <public-ipv4> <edge-bind-ip>

https://{args[0]} {
	tls {
		issuer acme {
			profile shortlived
			disable_http_challenge
		}
	}

	handle /coforge {
		redir /coforge/ 308
	}

	handle_path /coforge/* {
		reverse_proxy {args[1]}:18180
	}
}
