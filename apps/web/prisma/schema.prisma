generator client {
  provider        = "prisma-client"
  output          = "../generated"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
}

model Workspace {
  id                     String                  @id @default(uuid()) @db.Uuid
  slug                   String                  @unique
  name                   String
  members                WorkspaceMembership[]
  invitations            WorkspaceInvitation[]
  computers              WorkspaceComputer[]
  computerRuntimes       ComputerRuntime[]
  modelCatalogs          ComputerModelCatalog[]
  agents                 Agent[]
  weeklyReportAssistants WeeklyReportAssistant[]
  agentApiKeys           AgentApiKey[]
  daemonApiKeys          DaemonApiKey[]
  conversations          Conversation[]
  conversationMembers    ConversationMember[]
  messageDeliveries      AgentMessageDelivery[]
  agentActivity          AgentActivity[]
  reminders              Reminder[]
  reminderEvents         ReminderEvent[]
  attachments            Attachment[]
  attachmentUploadSessions AttachmentUploadSession[]
  tasks                  Task[]
  actionCards            ActionCard[]
  weeklyReportCycles     WeeklyReportCycle[]
  weeklyReports          WeeklyReport[]
  weeklyHighlights       WeeklyReportHighlight[]
  weeklyTemplates        WeeklyReportTemplate[]
  recordNotes            RecordNote[]
  recordComments         RecordComment[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  projects               Project[]

  @@map("workspaces")
}

model Project {
  id                   String         @id @default(uuid()) @db.Uuid
  workspaceId          String         @db.Uuid
  name                 String
  description          String         @default("")
  iconObjectKey        String?
  iconContentType      String?
  slug                 String
  githubInstallationId Int?
  githubRepositoryId   Int?
  githubFullName       String?
  githubHtmlUrl        String?
  workspace            Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations        Conversation[] @relation("ProjectConversations")
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@unique([workspaceId, slug])
  @@unique([workspaceId, githubRepositoryId])
  @@index([workspaceId])
  @@map("projects")
}

model User {
  id                          String                          @id @default(uuid()) @db.Uuid
  username                    String                          @unique
  displayName                 String?
  description                 String                          @default("")
  avatarObjectKey             String?
  avatarContentType           String?
  timeZone                    String?
  browserNotificationsEnabled Boolean                         @default(false)
  createdAt                   DateTime                        @default(now())
  identities                  UserIdentity[]
  gitHubConnection            GitHubConnection?
  gitHubAuthorization         GitHubAuthorization?
  gitHubUserInstallations     GitHubUserInstallation[]
  memberships                 WorkspaceMembership[]
  sentInvitations             WorkspaceInvitation[]           @relation("WorkspaceInvitationInviter")
  receivedInvitations         WorkspaceInvitation[]           @relation("WorkspaceInvitationInvitee")
  agents                      Agent[]
  weeklyReportAssistants      WeeklyReportAssistant[]
  agentApiKeys                AgentApiKey[]
  daemonApiKeys               DaemonApiKey[]
  computers                   Computer[]
  conversationMembers         ConversationMember[]
  webPushSubscriptions        WebPushSubscription[]
  attachments                 Attachment[]
  deviceAuthorizations        DeviceAuthorization[]
  weeklyReportCyclesCreated   WeeklyReportCycle[]             @relation("WeeklyReportCycleCreator")
  weeklyReportsAuthored       WeeklyReport[]                  @relation("WeeklyReportAuthor")
  weeklyReportFavorites       WeeklyReportFavorite[]
  weeklyTemplateRecipients    WeeklyReportTemplateRecipient[]
  weeklyTemplatesOwned        WeeklyReportTemplate[]          @relation("WeeklyReportTemplateOwner")
  recordNotesAuthored         RecordNote[]                    @relation("RecordNoteAuthor")
  recordCommentsAuthored      RecordComment[]                 @relation("RecordCommentAuthor")
  committedActionCards        ActionCard[]

  @@map("users")
}

model WebPushSubscription {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  endpoint       String    @unique
  p256dh         String
  auth           String
  expirationTime DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("web_push_subscriptions")
}

model UserIdentity {
  id              String @id @default(uuid()) @db.Uuid
  userId          String @db.Uuid
  provider        String
  providerSubject String
  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("user_identities")
}

/// Personal integration, never a login identity or shared Workspace credential.
model GitHubConnection {
  userId           String   @id @db.Uuid
  clientId         String
  githubUserId     String
  login            String
  credentials      String?
  expiresAt        DateTime
  refreshExpiresAt DateTime
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, githubUserId])
  @@map("github_connections")
}

/// One outstanding, browser-bound OAuth attempt per User, replaced on a new connect.
model GitHubAuthorization {
  userId    String   @id @db.Uuid
  stateHash String
  verifier  String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("github_authorizations")
}

/// Cache of a User's usable GitHub App installations, refreshed by GitHubConnection.sync()
/// and kept fresh by installation/installation_repositories webhooks. Read-only for Settings.
model GitHubUserInstallation {
  userId              String   @db.Uuid
  installationId      Int
  accountLogin        String
  repositorySelection String
  suspended           Boolean
  configureUrl        String
  syncedAt            DateTime
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, installationId])
  @@index([installationId])
  @@map("github_user_installations")
}

model Agent {
  id                        String                     @id @default(uuid()) @db.Uuid
  workspaceId               String                     @db.Uuid
  name                      String
  displayName               String
  description               String                     @default("")
  createdAt                 DateTime                   @default(now())
  ownerId                   String                     @db.Uuid
  computerId                String?                    @db.Uuid
  runtimeConfig             Json
  /// Runtime launch fencing only; provider-native identity lives in AgentSession.
  runtimeSession            Json?
  /// Current control request and fencing only, not Session history or a job queue.
  controlState              Json?
  currentSessionId          String?                    @db.Uuid
  currentSession            AgentSession?              @relation("CurrentAgentSession", fields: [currentSessionId], references: [id], onDelete: SetNull)
  sessions                  AgentSession[]             @relation("AgentSessions")
  workspace                 Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner                     User                       @relation(fields: [ownerId], references: [id])
  computer                  Computer?                  @relation(fields: [computerId], references: [id], onDelete: SetNull)
  conversations             ConversationMember[]
  deliveries                AgentMessageDelivery[]
  apiKeys                   AgentApiKey[]
  activity                  AgentActivity[]
  reminders                 Reminder[]
  reminderOperationReceipts ReminderOperationReceipt[]
  preparedActionCards       ActionCard[]
  weeklyReportAssistant     WeeklyReportAssistant?
  attachments               Attachment[]
  attachmentUploadSessions  AttachmentUploadSession[]

  @@unique([workspaceId, name])
  @@unique([id, workspaceId])
  @@index([workspaceId, ownerId])
  @@index([workspaceId, createdAt])
  @@index([computerId])
  @@map("agents")
}

/// One User's fixed Agent identity for weekly-report AI in one Workspace.
model WeeklyReportAssistant {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  userId      String    @db.Uuid
  agentId     String    @unique @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent       Agent     @relation(fields: [agentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@unique([agentId, workspaceId])
  @@index([workspaceId])
  @@index([userId])
  @@map("weekly_report_assistants")
}

/// A provider-native Session belongs to the Agent and the Computer/runtime that created it.
/// Switching runtime creates another record; it never relabels or converts the old transcript.
model AgentSession {
  id              String   @id @default(uuid()) @db.Uuid
  agentId         String   @db.Uuid
  workspaceId     String   @db.Uuid
  computerId      String   @db.Uuid
  provider        String
  nativeSessionId String?
  state           String   @default("unknown")
  createdAt       DateTime @default(now())
  agent           Agent    @relation("AgentSessions", fields: [agentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  currentFor      Agent[]  @relation("CurrentAgentSession")

  @@index([agentId, createdAt])
  @@map("agent_sessions")
}

model AgentActivity {
  id                      String    @id @default(uuid()) @db.Uuid
  workspaceId             String    @db.Uuid
  agentId                 String    @db.Uuid
  computerId              String    @db.Uuid
  launchId                String
  clientSeq               Int
  detailKind              String
  level                   String
  detail                  String
  entries                 Json?
  runtimeErrorClass       String?
  runtimeErrorReason      String?
  runtimeErrorFingerprint String?
  occurredAt              DateTime
  createdAt               DateTime  @default(now())
  agent                   Agent     @relation(fields: [agentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  workspace               Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  computer                Computer  @relation(fields: [computerId], references: [id], onDelete: Cascade)

  @@unique([agentId, launchId, clientSeq])
  @@index([workspaceId, agentId, occurredAt(sort: Desc), clientSeq(sort: Desc)])
  @@map("agent_activities")
}

model AgentApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  apiKeyHash  String    @unique
  agentId     String    @db.Uuid
  workspaceId String    @db.Uuid
  ownerId     String    @db.Uuid
  computerId  String    @db.Uuid
  revokedAt   DateTime?
  disabledAt  DateTime?
  createdAt   DateTime  @default(now())
  agent       Agent     @relation(fields: [agentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  computer    Computer  @relation(fields: [computerId], references: [id], onDelete: Cascade)

  @@index([agentId, workspaceId])
  @@index([ownerId])
  @@index([computerId])
  @@map("agent_api_keys")
}

model DaemonApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  apiKeyHash  String    @unique @map("api_key_hash")
  workspaceId String    @map("workspace_id") @db.Uuid
  computerId  String    @map("computer_id") @db.Uuid
  ownerId     String    @map("owner_id") @db.Uuid
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  lastUsedAt  DateTime? @map("last_used_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  computer    Computer  @relation(fields: [computerId], references: [id], onDelete: Cascade)
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([workspaceId, computerId])
  @@index([ownerId])
  @@map("daemon_api_keys")
}

/// One in-flight RFC 8628 device authorization grant. This is deliberately durable rather than
/// in-process state: the browser approving a grant and the Computer polling for it are different
/// requests that need not reach the same web replica, and a deploy between `login` and the user
/// finishing the approval page must not silently invalidate the grant.
///
/// Neither secret is stored in the clear. The device code is the bearer the Computer polls with,
/// and the user code is short enough to be typed - and therefore short enough to be guessed - so
/// both are looked up by hash, the same way daemon API keys are.
model DeviceAuthorization {
  id             String    @id @default(uuid()) @db.Uuid
  deviceCodeHash String    @unique @map("device_code_hash")
  userCodeHash   String    @unique @map("user_code_hash")
  /// Null until a signed-in browser approves this grant; the token is minted for this user.
  userId         String?   @map("user_id") @db.Uuid
  status         String    @default("pending")
  expiresAt      DateTime  @map("expires_at")
  approvedAt     DateTime? @map("approved_at")
  /// Last poll, so a Computer polling faster than the advertised interval gets `slow_down`.
  lastPolledAt   DateTime? @map("last_polled_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  user           User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
  @@map("device_authorizations")
}

model WorkspaceMembership {
  workspaceId String    @db.Uuid
  userId      String    @db.Uuid
  /// Workspace role: owner | admin | member. Owner is created at Workspace creation and is immutable.
  role        String    @default("member")
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
  @@map("workspace_memberships")
}

/// Pending human invites into a Workspace. Role is admin | member only; owner cannot be invited.
model WorkspaceInvitation {
  id            String    @id @default(uuid()) @db.Uuid
  workspaceId   String    @db.Uuid
  inviterUserId String    @db.Uuid
  inviteeUserId String    @db.Uuid
  role          String
  status        String    @default("pending")
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inviter       User      @relation("WorkspaceInvitationInviter", fields: [inviterUserId], references: [id], onDelete: Cascade)
  invitee       User      @relation("WorkspaceInvitationInvitee", fields: [inviteeUserId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([inviteeUserId, status])
  @@map("workspace_invitations")
}

model Computer {
  id                String                 @id @default(uuid()) @db.Uuid
  ownerId           String                 @db.Uuid
  machineId         String
  name              String                 @default("")
  displayName       String                 @default("")
  computerVersion   String?
  platform          String?
  osVersion         String?
  metadataStartedAt BigInt?
  /// Where this Computer runs: "local" on a machine the User controls,
  /// "cloud" on a CoForge-hosted sandbox node.
  kind              String                 @default("local")
  workspaces        WorkspaceComputer[]
  runtimes          ComputerRuntime[]
  modelCatalogs     ComputerModelCatalog[]
  agents            Agent[]
  agentApiKeys      AgentApiKey[]
  daemonApiKeys     DaemonApiKey[]
  agentActivity     AgentActivity[]
  reminders         Reminder[]
  owner             User                   @relation(fields: [ownerId], references: [id])

  @@unique([ownerId, machineId])
  @@map("computers")
}

model ComputerRuntime {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  computerId  String    @db.Uuid
  provider    String
  version     String
  displayName String
  observedAt  DateTime  @default(now())
  isPublic    Boolean   @default(false)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  computer    Computer  @relation(fields: [computerId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, computerId, provider])
  @@index([workspaceId, computerId])
  @@map("computer_runtimes")
}

model ComputerModelCatalog {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  computerId  String    @db.Uuid
  provider    String
  models      Json
  observedAt  DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  computer    Computer  @relation(fields: [computerId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, computerId, provider])
  @@index([workspaceId, computerId])
  @@map("computer_model_catalogs")
}

model WorkspaceComputer {
  id          String     @id @default(uuid()) @db.Uuid
  workspaceId String     @db.Uuid
  computerId  String     @db.Uuid
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  computer    Computer   @relation(fields: [computerId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  reminders   Reminder[]

  @@unique([workspaceId, computerId])
  @@map("workspace_computers")
}

model Conversation {
  id             String                 @id @default(uuid()) @db.Uuid
  workspaceId    String                 @db.Uuid
  projectId      String?                @db.Uuid
  directKey      String?
  channelName    String?
  nextTaskNumber Int                    @default(1)
  createdAt      DateTime               @default(now())
  workspace      Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members        ConversationMember[]
  messages       Message[]
  deliveries     AgentMessageDelivery[]
  attachments    Attachment[]
  attachmentUploadSessions AttachmentUploadSession[]
  tasks          Task[]
  actionCards    ActionCard[]
  project        Project?               @relation("ProjectConversations", fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, directKey])
  @@unique([workspaceId, channelName])
  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([projectId])
  @@map("conversations")
}

model ConversationMember {
  id                       String            @id @default(uuid()) @db.Uuid
  conversationId           String            @db.Uuid
  workspaceId              String            @db.Uuid
  userId                   String?           @db.Uuid
  agentId                  String?           @db.Uuid
  agentReadThroughSequence Int               @default(0)
  channelMuted             Boolean           @default(false)
  conversation             Conversation      @relation(fields: [conversationId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  workspace                Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                     User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent                    Agent?            @relation(fields: [agentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  messages                 Message[]
  threadReads              ThreadRead[]
  threadFollows            ThreadFollow[]
  reactions                MessageReaction[]
  ownedTasks               Task[]            @relation("TaskOwner")
  createdTasks             Task[]            @relation("TaskCreator")

  @@unique([id, conversationId, workspaceId])
  @@unique([conversationId, userId])
  @@unique([conversationId, agentId])
  @@index([workspaceId, userId])
  @@index([workspaceId, agentId])
  @@map("conversation_members")
}

model Message {
  id             String                 @id @default(uuid()) @db.Uuid
  conversationId String                 @db.Uuid
  workspaceId    String                 @db.Uuid
  senderMemberId String?                @db.Uuid
  body           String
  sequence       Int
  createdAt      DateTime               @default(now())
  conversation   Conversation           @relation(fields: [conversationId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  sender         ConversationMember?    @relation(fields: [senderMemberId, conversationId, workspaceId], references: [id, conversationId, workspaceId], onDelete: Restrict)
  deliveries     AgentMessageDelivery[]
  attachments    Attachment[]
  threadRootId   String?                @db.Uuid
  threadRoot     Message?               @relation("MessageThread", fields: [threadRootId, conversationId], references: [id, conversationId], onDelete: Cascade)
  replies        Message[]              @relation("MessageThread")
  threadReads    ThreadRead[]
  threadFollows  ThreadFollow[]
  reactions      MessageReaction[]
  task           Task?
  actionCard     ActionCard?

  @@unique([id, conversationId])
  @@unique([conversationId, sequence])
  @@index([conversationId, threadRootId, sequence])
  @@index([conversationId, createdAt])
  @@map("messages")
}

model Task {
  messageId                    String              @id @db.Uuid
  conversationId               String              @db.Uuid
  workspaceId                  String              @db.Uuid
  number                       Int
  title                        String
  description                  String?
  createsResource              Boolean             @default(false)
  resourceReceipt              Json?
  resourceReceiptRecordedAt    DateTime?
  resourceTeardownOwnerAgentId String?             @db.Uuid
  resourceExpiryFollowupId     String?             @db.Uuid
  status                       String              @default("todo")
  revision                     Int                 @default(0)
  ownerMemberId                String?             @db.Uuid
  claimedAt                    DateTime?
  creatorMemberId              String              @db.Uuid
  requestId                    String?             @db.Uuid
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt
  message                      Message             @relation(fields: [messageId, conversationId], references: [id, conversationId], onDelete: Cascade)
  conversation                 Conversation        @relation(fields: [conversationId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  workspace                    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner                        ConversationMember? @relation("TaskOwner", fields: [ownerMemberId, conversationId, workspaceId], references: [id, conversationId, workspaceId], onDelete: Restrict)
  creator                      ConversationMember  @relation("TaskCreator", fields: [creatorMemberId, conversationId, workspaceId], references: [id, conversationId, workspaceId], onDelete: Restrict)
  history                      TaskHistoryEvent[]

  @@unique([conversationId, number])
  @@unique([messageId, conversationId])
  @@unique([conversationId, creatorMemberId, requestId])
  @@index([workspaceId, conversationId, status])
  @@map("tasks")
}

model TaskHistoryEvent {
  id                String   @id @default(uuid()) @db.Uuid
  taskMessageId     String   @db.Uuid
  sequence          Int
  eventType         String
  actorKind         String
  actorName         String?
  beforeTitle       String?
  afterTitle        String?
  beforeDescription String?
  afterDescription  String?
  createdAt         DateTime @default(now())
  task              Task     @relation(fields: [taskMessageId], references: [messageId], onDelete: Cascade)

  @@unique([taskMessageId, sequence])
  @@index([taskMessageId, createdAt])
  @@map("task_history_events")
}

/// An Agent-prepared typed action card (`coforge action prepare`), message-anchored like Task.
/// `payload` stores the resolved, UUID-only action (no handles); a human commits it under their
/// own identity in a follow-up PR, which will set `state`/`committedByUserId`/`committedAt`/`result`.
model ActionCard {
  messageId         String       @id @db.Uuid
  conversationId    String       @db.Uuid
  workspaceId       String       @db.Uuid
  /// channel:create | agent:create | channel:add_member
  kind              String
  payload           Json
  draftHint         String?
  preparedByAgentId String       @db.Uuid
  /// pending | executed | cancelled
  state             String       @default("pending")
  committedByUserId String?      @db.Uuid
  committedAt       DateTime?
  result            Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  message           Message      @relation(fields: [messageId, conversationId], references: [id, conversationId], onDelete: Cascade)
  conversation      Conversation @relation(fields: [conversationId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  workspace         Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  preparedByAgent   Agent        @relation(fields: [preparedByAgentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  committedByUser   User?        @relation(fields: [committedByUserId], references: [id], onDelete: SetNull)

  @@unique([messageId, conversationId])
  @@index([workspaceId, state])
  @@map("action_cards")
}

model ThreadRead {
  memberId            String             @db.Uuid
  rootMessageId       String             @db.Uuid
  conversationId      String             @db.Uuid
  workspaceId         String             @db.Uuid
  readThroughSequence Int                @default(0)
  member              ConversationMember @relation(fields: [memberId, conversationId, workspaceId], references: [id, conversationId, workspaceId], onDelete: Cascade)
  root                Message            @relation(fields: [rootMessageId, conversationId], references: [id, conversationId], onDelete: Cascade)

  @@id([memberId, rootMessageId])
  @@map("thread_reads")
}

model ThreadFollow {
  memberId       String             @db.Uuid
  rootMessageId  String             @db.Uuid
  conversationId String             @db.Uuid
  workspaceId    String             @db.Uuid
  createdAt      DateTime           @default(now())
  member         ConversationMember @relation(fields: [memberId, conversationId, workspaceId], references: [id, conversationId, workspaceId], onDelete: Cascade)
  root           Message            @relation(fields: [rootMessageId, conversationId], references: [id, conversationId], onDelete: Cascade)

  @@id([memberId, rootMessageId])
  @@map("thread_follows")
}

model MessageReaction {
  messageId      String             @db.Uuid
  conversationId String             @db.Uuid
  workspaceId    String             @db.Uuid
  memberId       String             @db.Uuid
  emoji          String
  createdAt      DateTime           @default(now())
  message        Message            @relation(fields: [messageId, conversationId], references: [id, conversationId], onDelete: Cascade)
  member         ConversationMember @relation(fields: [memberId, conversationId, workspaceId], references: [id, conversationId, workspaceId], onDelete: Cascade)

  @@id([messageId, memberId, emoji])
  @@index([conversationId, messageId])
  @@map("message_reactions")
}

model Attachment {
  id              String       @id @default(uuid()) @db.Uuid
  workspaceId     String       @db.Uuid
  conversationId  String       @db.Uuid
  /// Exactly one of `uploaderId` / `uploaderAgentId` is set; enforced in
  /// `storeAttachment`/`storeAgentAttachment`, not a DB check constraint (see ADR 0023).
  uploaderId      String?      @db.Uuid
  uploaderAgentId String?      @db.Uuid
  messageId       String?      @db.Uuid
  /// Stable per-message ordering for multiple attachments; irrelevant while messageId is null.
  position        Int          @default(0)
  objectKey       String       @unique
  fileName        String
  contentType     String
  sizeBytes       Int
  createdAt       DateTime     @default(now())
  workspace       Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation    Conversation @relation(fields: [conversationId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  uploader        User?        @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  uploaderAgent   Agent?       @relation(fields: [uploaderAgentId], references: [id], onDelete: Cascade)
  message         Message?     @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([conversationId, workspaceId])
  @@index([uploaderId])
  @@index([uploaderAgentId])
  @@index([messageId, position])
  @@map("attachments")
}

/// A reserved presigned-upload session (ADR 0028): the Agent PUTs bytes straight to storage,
/// then `complete` verifies the object and creates the `Attachment` row that `attachmentId`
/// reserves ahead of time. `attachmentId` is not a foreign key — that row does not exist until
/// verification succeeds — only a unique reservation the eventual `Attachment.id` must match.
model AttachmentUploadSession {
  id              String       @id @default(uuid()) @db.Uuid
  workspaceId     String       @db.Uuid
  conversationId  String       @db.Uuid
  agentId         String       @db.Uuid
  attachmentId    String       @unique @db.Uuid
  objectKey       String       @unique
  fileName        String
  contentType     String
  sizeBytes       Int
  clientRequestId String       @db.Uuid
  state           String       @default("pending")
  terminalReason  String?
  expiresAt       DateTime
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  workspace       Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation    Conversation @relation(fields: [conversationId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  agent           Agent        @relation(fields: [agentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([agentId, clientRequestId])
  @@index([conversationId, workspaceId])
  @@index([expiresAt])
  @@map("attachment_upload_sessions")
}

model AgentMessageDelivery {
  deliveryId     String       @id @default(uuid()) @db.Uuid
  messageId      String       @db.Uuid
  workspaceId    String       @db.Uuid
  conversationId String       @db.Uuid
  agentId        String       @db.Uuid
  sequence       Int
  receivedAt     DateTime?
  createdAt      DateTime     @default(now())
  message        Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent          Agent        @relation(fields: [agentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([messageId, agentId])
  @@unique([deliveryId, workspaceId])
  @@index([workspaceId, agentId, receivedAt])
  @@map("agent_message_deliveries")
}

/// Canonical cloud scheduling state. Daemons only own volatile timers for these records.
model Reminder {
  id                String                     @id @default(uuid()) @db.Uuid
  workspaceId       String                     @db.Uuid
  ownerAgentId      String                     @db.Uuid
  computerId        String                     @db.Uuid
  title             String
  target            String
  messageId         String                     @db.Uuid
  fireAt            DateTime
  repeat            String?
  timezone          String?
  status            String                     @default("scheduled")
  version           Int                        @default(1)
  firedAt           DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  workspace         Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownerAgent        Agent                      @relation(fields: [ownerAgentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  computer          Computer                   @relation(fields: [computerId], references: [id], onDelete: Cascade)
  workspaceComputer WorkspaceComputer          @relation(fields: [workspaceId, computerId], references: [workspaceId, computerId], onDelete: Cascade)
  events            ReminderEvent[]
  fireReceipts      ReminderFireReceipt[]
  operationReceipts ReminderOperationReceipt[]

  @@unique([id, workspaceId])
  @@index([workspaceId, ownerAgentId, status, fireAt])
  @@map("reminders")
}

/// Stable Agent CRUD request replay. This is reminder-specific, not a general mailbox.
model ReminderOperationReceipt {
  workspaceId String   @db.Uuid
  agentId     String   @db.Uuid
  requestId   String   @db.VarChar(128)
  fingerprint String
  response    Bytes
  reminderId  String   @db.Uuid
  createdAt   DateTime @default(now())
  agent       Agent    @relation(fields: [agentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  reminder    Reminder @relation(fields: [reminderId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@id([agentId, requestId])
  @@index([reminderId])
  @@map("reminder_operation_receipts")
}

model ReminderEvent {
  id           String    @id @default(uuid()) @db.Uuid
  reminderId   String    @db.Uuid
  workspaceId  String    @db.Uuid
  type         String
  title        String
  time         DateTime  @default(now())
  scheduledFor DateTime
  nextFireAt   DateTime?
  reminder     Reminder  @relation(fields: [reminderId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([reminderId, time(sort: Desc)])
  @@map("reminder_events")
}

/// Exact response bytes are retained so a request replay is identical after recurring advancement.
model ReminderFireReceipt {
  requestId   String   @db.VarChar(128)
  reminderId  String   @db.Uuid
  workspaceId String   @db.Uuid
  computerId  String   @db.Uuid
  agentId     String   @db.Uuid
  version     Int
  response    Bytes
  createdAt   DateTime @default(now())
  reminder    Reminder @relation(fields: [reminderId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@id([reminderId, requestId])
  @@map("reminder_fire_receipts")
}

/// ISO week bucket for Workspace Records (成员周报 / 周报要点 grouping).
model WeeklyReportCycle {
  id          String                 @id @default(uuid()) @db.Uuid
  workspaceId String                 @db.Uuid
  year        Int
  week        Int
  title       String
  createdById String                 @db.Uuid
  createdAt   DateTime               @default(now())
  workspace   Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User                   @relation("WeeklyReportCycleCreator", fields: [createdById], references: [id], onDelete: Cascade)
  reports     WeeklyReport[]
  highlight   WeeklyReportHighlight?
  comments    RecordComment[]        @relation("CycleComments")

  @@unique([workspaceId, year, week])
  @@index([workspaceId, year, week])
  @@map("weekly_report_cycles")
}

/// Member or cycle-template weekly report document with Markdown JSON body.
model WeeklyReport {
  id               String                 @id @default(uuid()) @db.Uuid
  workspaceId      String                 @db.Uuid
  cycleId          String                 @db.Uuid
  authorId         String                 @db.Uuid
  /// When kind=member, optional template this submission was written against.
  sourceTemplateId String?                @db.Uuid
  /// When kind=template, optional send-settings stream this format/overview belongs to.
  settingsId       String?                @db.Uuid
  /// member | template
  kind             String
  title            String
  /// draft | submitted | shared
  status           String                 @default("draft")
  content          Json
  submittedAt      DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  workspace        Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cycle            WeeklyReportCycle      @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  author           User                   @relation("WeeklyReportAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  sourceTemplate   WeeklyReport?          @relation("TemplateSubmissions", fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  submissions      WeeklyReport[]         @relation("TemplateSubmissions")
  settings         WeeklyReportTemplate?  @relation(fields: [settingsId], references: [id], onDelete: SetNull)
  favorites        WeeklyReportFavorite[]
  comments         RecordComment[]        @relation("ReportComments")

  @@index([workspaceId, authorId])
  @@index([cycleId, kind])
  @@index([cycleId, authorId, kind])
  @@index([sourceTemplateId])
  @@index([settingsId])
  @@map("weekly_reports")
}

model WeeklyReportHighlight {
  id          String            @id @default(uuid()) @db.Uuid
  workspaceId String            @db.Uuid
  cycleId     String            @unique @db.Uuid
  title       String
  content     Json
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cycle       WeeklyReportCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  comments    RecordComment[]   @relation("HighlightComments")

  @@index([workspaceId])
  @@map("weekly_report_highlights")
}

model WeeklyReportFavorite {
  userId    String       @db.Uuid
  reportId  String       @db.Uuid
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  report    WeeklyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@id([userId, reportId])
  @@index([reportId])
  @@map("weekly_report_favorites")
}

/// Per-user send configuration (周报设置); not shared across Workspace members.
model WeeklyReportTemplate {
  id              String                          @id @default(uuid()) @db.Uuid
  workspaceId     String                          @db.Uuid
  /// Owning User; list/mutate/apply are private to this user within the Workspace.
  ownerId         String                          @db.Uuid
  name            String
  /// weekly
  frequency       String                          @default("weekly")
  sendTime        String                          @default("15:00")
  /// ISO weekday 1=Monday … 7=Sunday; default Friday.
  sendWeekday     Int                             @default(5)
  dimensions      Json
  mainTitles      Json
  allMembers      Boolean                         @default(false)
  /// When true, this settings row is an active send stream (multiple allowed per owner).
  applied         Boolean                         @default(false)
  /// When true with applied, scheduled/periodic send is allowed.
  scheduleEnabled Boolean                         @default(false)
  createdAt       DateTime                        @default(now())
  updatedAt       DateTime                        @updatedAt
  workspace       Workspace                       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner           User                            @relation("WeeklyReportTemplateOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  recipients      WeeklyReportTemplateRecipient[]
  reports         WeeklyReport[]

  @@index([workspaceId])
  @@index([workspaceId, ownerId])
  @@index([workspaceId, applied])
  @@map("weekly_report_templates")
}

model WeeklyReportTemplateRecipient {
  templateId String               @db.Uuid
  userId     String               @db.Uuid
  template   WeeklyReportTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([templateId, userId])
  @@index([userId])
  @@map("weekly_report_template_recipients")
}

model RecordNote {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  authorId    String    @db.Uuid
  title       String
  body        String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author      User      @relation("RecordNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([workspaceId, authorId])
  @@map("record_notes")
}

/// Side-panel comments on Record subjects; assistant authorType reserved for future AI.
model RecordComment {
  id           String                 @id @default(uuid()) @db.Uuid
  workspaceId  String                 @db.Uuid
  /// report | highlight | cycle
  subjectType  String
  reportId     String?                @db.Uuid
  highlightId  String?                @db.Uuid
  cycleId      String?                @db.Uuid
  /// user | system | assistant
  authorType   String
  authorUserId String?                @db.Uuid
  body         String
  payload      Json?
  createdAt    DateTime               @default(now())
  workspace    Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  authorUser   User?                  @relation("RecordCommentAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  report       WeeklyReport?          @relation("ReportComments", fields: [reportId], references: [id], onDelete: Cascade)
  highlight    WeeklyReportHighlight? @relation("HighlightComments", fields: [highlightId], references: [id], onDelete: Cascade)
  cycle        WeeklyReportCycle?     @relation("CycleComments", fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([workspaceId, subjectType, createdAt])
  @@index([reportId])
  @@index([highlightId])
  @@index([cycleId])
  @@map("record_comments")
}
