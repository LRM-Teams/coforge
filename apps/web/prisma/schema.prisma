generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

model Workspace {
  id                  String                 @id @default(uuid()) @db.Uuid
  slug                String                 @unique
  name                String
  members             WorkspaceMembership[]
  computers           WorkspaceComputer[]
  agents              Agent[]
  agentApiKeys        AgentApiKey[]
  daemonApiKeys       DaemonApiKey[]
  conversations       Conversation[]
  conversationMembers ConversationMember[]
  messageDeliveries   AgentMessageDelivery[]
  agentActivity       AgentActivity[]
  attachments         Attachment[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  @@map("workspaces")
}

model User {
  id                  String                @id @default(uuid()) @db.Uuid
  username            String                @unique
  timeZone            String?
  createdAt           DateTime              @default(now())
  identities          UserIdentity[]
  memberships         WorkspaceMembership[]
  agents              Agent[]
  agentApiKeys        AgentApiKey[]
  daemonApiKeys       DaemonApiKey[]
  computers           Computer[]
  conversationMembers ConversationMember[]
  attachments         Attachment[]
  @@map("users")
}

model UserIdentity {
  id              String @id @default(uuid()) @db.Uuid
  userId          String @db.Uuid
  provider        String
  providerSubject String
  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("user_identities")
}

model Agent {
  id            String                 @id @default(uuid()) @db.Uuid
  workspaceId   String                 @db.Uuid
  name          String
  displayName   String
  createdAt     DateTime               @default(now())
  ownerId       String                 @db.Uuid
  computerId    String?                @db.Uuid
  runtimeConfig Json
  workspace     Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner         User                   @relation(fields: [ownerId], references: [id])
  computer      Computer?              @relation(fields: [computerId], references: [id], onDelete: SetNull)
  conversations ConversationMember[]
  deliveries    AgentMessageDelivery[]
  apiKeys       AgentApiKey[]
  activity      AgentActivity[]

  @@unique([workspaceId, name])
  @@unique([id, workspaceId])
  @@index([workspaceId, ownerId])
  @@index([workspaceId, createdAt])
  @@index([computerId])
  @@map("agents")
}

model AgentActivity {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  agentId     String    @db.Uuid
  computerId  String    @db.Uuid
  launchId    String
  clientSeq   Int
  activity    String
  level       String
  message     String
  diagnosticErrorClass String?
  diagnosticReason String?
  diagnosticFingerprint String?
  occurredAt  DateTime
  createdAt   DateTime  @default(now())
  agent       Agent     @relation(fields: [agentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  computer    Computer  @relation(fields: [computerId], references: [id], onDelete: Cascade)

  @@unique([agentId, launchId, clientSeq])
  @@index([workspaceId, agentId, occurredAt(sort: Desc), clientSeq(sort: Desc)])
  @@map("agent_activities")
}

model AgentApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  apiKeyHash  String    @unique
  agentId     String    @db.Uuid
  workspaceId String    @db.Uuid
  ownerId     String    @db.Uuid
  computerId  String    @db.Uuid
  revokedAt   DateTime?
  disabledAt  DateTime?
  createdAt   DateTime  @default(now())
  agent       Agent     @relation(fields: [agentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  computer    Computer  @relation(fields: [computerId], references: [id], onDelete: Cascade)

  @@index([agentId, workspaceId])
  @@index([ownerId])
  @@index([computerId])
  @@map("agent_api_keys")
}

model DaemonApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  apiKeyHash  String    @unique @map("api_key_hash")
  workspaceId String    @db.Uuid @map("workspace_id")
  computerId  String    @db.Uuid @map("computer_id")
  ownerId     String    @db.Uuid @map("owner_id")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  lastUsedAt  DateTime? @map("last_used_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  computer    Computer  @relation(fields: [computerId], references: [id], onDelete: Cascade)
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([workspaceId, computerId])
  @@index([ownerId])
  @@map("daemon_api_keys")
}

model WorkspaceMembership {
  workspaceId String    @db.Uuid
  userId      String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
  @@map("workspace_memberships")
}

model Computer {
  id            String              @id @default(uuid()) @db.Uuid
  ownerId       String              @db.Uuid
  machineId     String
  /// Where this Computer runs: "local" on a machine the User controls,
  /// "cloud" on a CoForge-hosted sandbox node.
  kind          String              @default("local")
  workspaces    WorkspaceComputer[]
  runtimes      ComputerRuntime[]
  modelCatalogs ComputerModelCatalog[]
  agents        Agent[]
  agentApiKeys AgentApiKey[]
  daemonApiKeys DaemonApiKey[]
  agentActivity AgentActivity[]
  owner         User                @relation(fields: [ownerId], references: [id])

  @@unique([ownerId, machineId])
  @@map("computers")
}

model ComputerRuntime {
  id          String   @id @default(uuid()) @db.Uuid
  computerId  String   @db.Uuid
  provider    String
  version     String
  displayName String
  observedAt  DateTime @default(now())
  isPublic    Boolean  @default(false)
  computer    Computer @relation(fields: [computerId], references: [id], onDelete: Cascade)

  @@unique([computerId, provider])
  @@index([computerId])
  @@map("computer_runtimes")
}

model ComputerModelCatalog {
  id         String   @id @default(uuid()) @db.Uuid
  computerId String   @db.Uuid
  provider   String
  models     Json
  observedAt DateTime @default(now())
  computer   Computer @relation(fields: [computerId], references: [id], onDelete: Cascade)

  @@unique([computerId, provider])
  @@index([computerId])
  @@map("computer_model_catalogs")
}

model WorkspaceComputer {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  computerId  String    @unique @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  computer    Computer  @relation(fields: [computerId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, computerId])
  @@map("workspace_computers")
}

model Conversation {
  id          String                 @id @default(uuid()) @db.Uuid
  workspaceId String                 @db.Uuid
  directKey   String
  createdAt   DateTime               @default(now())
  workspace   Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     ConversationMember[]
  messages    Message[]
  deliveries  AgentMessageDelivery[]
  attachments Attachment[]

  @@unique([workspaceId, directKey])
  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@map("conversations")
}

model ConversationMember {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  workspaceId    String       @db.Uuid
  userId         String?      @db.Uuid
  agentId        String?      @db.Uuid
  conversation   Conversation @relation(fields: [conversationId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent          Agent?       @relation(fields: [agentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  messages       Message[]

  @@unique([id, conversationId, workspaceId])
  @@unique([conversationId, userId])
  @@unique([conversationId, agentId])
  @@index([workspaceId, userId])
  @@index([workspaceId, agentId])
  @@map("conversation_members")
}

model Message {
  id             String                 @id @default(uuid()) @db.Uuid
  conversationId String                 @db.Uuid
  workspaceId    String                 @db.Uuid
  senderMemberId String                 @db.Uuid
  body           String
  sequence       Int
  createdAt      DateTime               @default(now())
  conversation   Conversation           @relation(fields: [conversationId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  sender         ConversationMember     @relation(fields: [senderMemberId, conversationId, workspaceId], references: [id, conversationId, workspaceId], onDelete: Restrict)
  deliveries     AgentMessageDelivery[]
  attachment     Attachment?

  @@unique([conversationId, sequence])
  @@index([conversationId, createdAt])
  @@map("messages")
}

model Attachment {
  id             String       @id @default(uuid()) @db.Uuid
  workspaceId    String       @db.Uuid
  conversationId String       @db.Uuid
  uploaderId     String       @db.Uuid
  messageId      String?      @unique @db.Uuid
  objectKey      String       @unique
  fileName       String
  contentType    String
  sizeBytes      Int
  createdAt      DateTime     @default(now())
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  uploader       User         @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  message        Message?     @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([conversationId, workspaceId])
  @@index([uploaderId])
  @@map("attachments")
}

model AgentMessageDelivery {
  deliveryId     String       @id @default(uuid()) @db.Uuid
  messageId      String       @db.Uuid
  workspaceId    String       @db.Uuid
  conversationId String       @db.Uuid
  agentId        String       @db.Uuid
  sequence       Int
  receivedAt     DateTime?
  createdAt      DateTime     @default(now())
  message        Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent          Agent        @relation(fields: [agentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([messageId, agentId])
  @@unique([deliveryId, workspaceId])
  @@index([workspaceId, agentId, receivedAt])
  @@map("agent_message_deliveries")
}
