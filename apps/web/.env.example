AUTHING_APP_ID=6a8fde6fa804dd3bea560bac
AUTHING_APP_SECRET=
AUTHING_ISSUER=https://coforge.authing.cn/oidc
AUTHING_REDIRECT_URI=http://localhost:8788/auth/callback
COFORGE_SESSION_SECRET=
# 64 hexadecimal characters; encrypts per-Agent model provider API keys.
COFORGE_AGENT_RUNTIME_CREDENTIAL_KEY=
# Local development: point this at compose.postgres.yaml.
DATABASE_URL=postgresql://coforge:change-me@127.0.0.1:5432/coforge
# Required only by message send paths. URL-encode the password if necessary.
REDIS_URL=redis://:change-me@127.0.0.1:6379
COFORGE_WORKER_JWT_PRIVATE_JWK=
COFORGE_WORKER_JWT_KEY_ID=
COFORGE_WORKER_JWT_ISSUER=coforge
COFORGE_WORKER_JWT_AUDIENCE=coforge-centrifugo
COFORGE_WORKER_JWT_LIFETIME_SECONDS=900
# Shared secret for POST /api/internal/weekly-report-schedule (external cron).
COFORGE_WEEKLY_REPORT_CRON_SECRET=
# URL-safe base64 VAPID P-256 public key. It may be returned to authenticated clients.
COFORGE_WEB_PUSH_PUBLIC_KEY=
# Server-only file containing the matching VAPID private key; never commit this file.
COFORGE_WEB_PUSH_PRIVATE_KEY_FILE=
COFORGE_WEB_PUSH_SUBJECT=https://coforge.cn
# Where chat attachment and avatar bytes live: "local" (default) keeps them in a
# private backend directory (see COFORGE_FILE_STORAGE_DIR in file-storage.server.ts)
# for local development; "oss" reads/writes an Alibaba Cloud OSS bucket instead.
# COFORGE_FILE_STORAGE=local
# Required when COFORGE_FILE_STORAGE=oss.
# COFORGE_OSS_BUCKET=
# Required when COFORGE_FILE_STORAGE=oss, e.g. cn-beijing.
# COFORGE_OSS_REGION=
# OSS credentials come from ALIBABA_CLOUD_ACCESS_KEY_ID / ALIBABA_CLOUD_ACCESS_KEY_SECRET
# (each also accepted as <NAME>_FILE pointing at a Docker secret file); when neither is
# set, the ali-oss SDK falls back to its default credential chain (e.g. ECS instance RAM
# role).
# ALIBABA_CLOUD_ACCESS_KEY_ID=
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# COFORGE_DEV_SKIP_AUTH=1
