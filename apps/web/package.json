{
  "name": "@coforge/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun --bun vite dev",
    "generate-i18n": "bun run ./scripts/generate-i18n.ts",
    "generate-routes": "tsr generate",
    "build": "bun --bun vite build",
    "start": "bun run .output/server/index.mjs",
    "preview": "bun --bun vite preview",
    "test": "bun run generate-i18n && bun test",
    "check": "bun run generate-i18n && bun run generate-routes && bun run format:check && bun run lint && bun run typecheck",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@tanstack/react-hotkeys": "0.10.0",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-start": "1.168.49",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.34.0",
    "nitro": "3.0.260610-beta",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.11.8",
    "@inlang/paraglide-js": "2.4.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-cli": "1.167.33",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/bun": "1.4.0",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "happy-dom": "20.11.8",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "shadcn": "4.19.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
