{
  "name": "@coforge/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun --bun vite dev --port 8788 --host 127.0.0.1 --strictPort",
    "dev:frontend": "bun run ./scripts/start-web.ts",
    "dev:backend": "bun run ./scripts/start-server.ts",
    "generate-i18n": "bun run ./scripts/generate-i18n.ts",
    "build": "bun --bun vite build",
    "start": "bun run .output/server/index.mjs",
    "preview": "bun --bun vite preview",
    "test": "bun run generate-i18n && bun test --max-concurrency=1 --isolate",
    "check": "bun run generate-i18n && bun run format:check && bun run lint && bun run typecheck",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "db:validate": "bunx --bun prisma validate",
    "db:generate": "bunx --bun prisma generate",
    "db:migrate:dev": "bunx --bun prisma migrate dev",
    "db:migrate:deploy": "bunx --bun prisma migrate deploy",
    "db:studio": "bunx --bun prisma studio",
    "pretest": "bun run db:generate",
    "precheck": "bun run db:generate",
    "prebuild": "bun run db:generate",
    "dev:hmr": "bun run ./scripts/dev-web-hmr.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@coforge/protocol": "workspace:*",
    "@dnd-kit/core": "6.3.1",
    "@floating-ui/dom": "^1.7.6",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@lobehub/icons-static-svg": "^1.95.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-hotkeys": "0.10.0",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-start": "1.168.49",
    "@tanstack/react-virtual": "3.14.10",
    "@tiptap/core": "3.22.1",
    "@tiptap/extension-code-block-lowlight": "3.22.1",
    "@tiptap/extension-highlight": "3.22.1",
    "@tiptap/extension-image": "3.22.1",
    "@tiptap/extension-link": "3.22.1",
    "@tiptap/extension-list": "3.22.1",
    "@tiptap/extension-mention": "3.22.1",
    "@tiptap/extension-placeholder": "3.22.1",
    "@tiptap/extension-table": "3.22.1",
    "@tiptap/extension-table-cell": "3.22.1",
    "@tiptap/extension-table-header": "3.22.1",
    "@tiptap/extension-table-row": "3.22.1",
    "@tiptap/extension-typography": "3.22.1",
    "@tiptap/markdown": "3.22.1",
    "@tiptap/pm": "3.22.1",
    "@tiptap/react": "3.22.1",
    "@tiptap/starter-kit": "3.22.1",
    "@tiptap/suggestion": "3.22.1",
    "@untitledui/icons": "^0.0.22",
    "centrifuge": "5.2.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "^0.2.6",
    "hast-util-to-html": "^9.0.5",
    "highlight.js": "^11.11.1",
    "input-otp": "^1.5.0",
    "jose": "^6.2.10",
    "katex": "^0.16.22",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.511.0",
    "mermaid": "^11.6.0",
    "motion": "^13.2.0",
    "nitro": "3.0.260610-beta",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-aria": "^3.51.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.12.4",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "web-push": "3.6.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.11.8",
