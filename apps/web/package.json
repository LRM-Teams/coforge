    "@testing-library/user-event": "14.6.6",
    "@types/bun": "1.4.0",
    "@types/node": "26.4.0",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "6.1.0",
    "happy-dom": "20.11.8",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
