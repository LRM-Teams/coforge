{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["src/routeTree.gen.ts"],
  "jsPlugins": ["./scripts/oxlint-plugin.js"],
  "rules": {
    "coforge/no-native-button": "error",
    "coforge/no-native-select": "error",
    "coforge/no-native-title": "error"
  },
  "overrides": [
    {
      "files": [
        "src/components/ui/button.tsx",
        "src/components/ui/select.tsx",
        "src/components/ui/tooltip.tsx"
      ],
      "rules": {
        "coforge/no-native-button": "off"
      }
    },
    {
      "files": ["test/**/*.{ts,tsx}"],
      "rules": {
        "coforge/no-native-button": "off"
      }
    },
    {
      "files": ["src/features/records/report-editor/**/*.{ts,tsx}"],
      "rules": {
        "coforge/no-native-button": "off",
        "coforge/no-native-title": "off"
      }
    }
  ]
}
