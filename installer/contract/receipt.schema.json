{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "operation": {
      "type": "string",
      "const": "upgrade"
    },
    "status": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed"
      ]
    },
    "version": {
      "type": "string"
    },
    "restoredVersion": {
      "type": "string"
    },
    "error": {
      "type": "string"
    },
    "errorCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "supervisorRunning": {
      "type": "boolean"
    },
    "runtimes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "bindingId": {
            "type": "string"
          },
          "running": {
            "type": "boolean"
          }
        },
        "required": [
          "bindingId",
          "running"
        ],
        "additionalProperties": {}
      }
    },
    "protocol": {
      "type": "string",
      "const": "coforge-installer/v1"
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "number",
          "const": 0
        },
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 3
        }
      ]
    },
    "installer_version": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "operation",
    "status",
    "protocol",
    "exit_code",
    "installer_version"
  ],
  "additionalProperties": {},
  "title": "coforge-installer upgrade receipt"
}
